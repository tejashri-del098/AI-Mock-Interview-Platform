# AI Mock Interview Platform Environment Configuration Template
# Copy this file to '.env' and fill in your API keys

# LLM API Keys (Provide at least one)
# Get a Gemini key from: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY="your-gemini-api-key-here"

# Get a Groq key from: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

# Server Configuration
PORT=8000
HOST=127.0.0.1
